{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=/api/:path*" },
    { "source": "/images/vehicles/:filename", "destination": "/api/index?route=/images/vehicles/:filename" },
    { "source": "/images/cache/:filename", "destination": "/api/index?route=/images/cache/:filename" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
