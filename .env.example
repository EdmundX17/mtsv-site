# Optional server key for any Gemini-backed feature enabled in this deployment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional canonical public app URL for integrations that need a fixed origin.
APP_URL="MY_APP_URL"

# DISCORD_CHANGELOG_WEBHOOK_URL: Webhook URL for catalog and valuation updates
DISCORD_CHANGELOG_WEBHOOK_URL=""

# DISCORD_REPORTS_WEBHOOK_URL: Webhook URL for community suggestion submissions
DISCORD_REPORTS_WEBHOOK_URL=""

# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY: Public Turnstile sitekey for the production widget
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=""

# CLOUDFLARE_TURNSTILE_SECRET_KEY: Private key for server-side verification
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# Firebase Admin SDK service account JSON. Server-only; never prefix with VITE_.
# In Vercel, paste the complete JSON downloaded from Firebase Project Settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Initial Admin username and a unique password of at least 16 characters.
# Server-only. Remove both after the first successful Admin sign-in.
STAFF_BOOTSTRAP_USERNAME=""
STAFF_BOOTSTRAP_PASSWORD=""
